{
  "expo": {
    "name": "Mary App",
    "slug": "citizen-complaint-app",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/santamarialogoapp.jpg",
    "scheme": "citizencomplaintapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maryapp.user",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to upload valid identification during registration and attach images to complaints.",
        "NSCameraUsageDescription": "This app needs access to your camera to capture identification documents and take photos for complaints.",
        "NSPhotoLibraryAddUsageDescription": "This app needs access to save photos to your library.",
        "NSMicrophoneUsageDescription": "This app needs access to your microphone to record videos for complaints.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize",
      "notification": {
        "icon": "./assets/images/santamarialogoapp.jpg",
        "color": "#346739",
        "androidMode": "default"
      },
      "adaptiveIcon": {
        "backgroundColor": "#10B981",
        "foregroundImage": "./assets/images/santamarialogoapp.png"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.maryapp.user"
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/santamarialogoapp.jpg",
          "color": "#346739",
          "sounds": []
        }
      ],
      "./plugins/greenTheme",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/santamarialogoapp.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#346739",
          "dark": {
            "backgroundColor": "#346739"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "This app needs access to your photo library to upload valid identification during registration and attach images to complaints.",
          "cameraPermission": "This app needs access to your camera to capture identification documents and take photos for complaints.",
          "microphonePermission": "This app needs access to your microphone to record videos for complaints."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-video",
      "expo-web-browser",
      "expo-font",
      "expo-localization",
      "@clerk/expo",
      "@clerk/expo-google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7d93d2b8-b751-456a-8037-f808aa7b6586"
      },
      "EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID": "989967452939-g8st5jqlcbgkab4eei27dff5v612jhfh.apps.googleusercontent.com",
      "EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID": "989967452939-3jkq2nmphaefbic8hk5stt9ukeqp53ip.apps.googleusercontent.com"
    },
    "owner": "edrhovic"
  }
}